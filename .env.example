# Calendly embed URL (optional) — e.g. https://calendly.com/your-name/30min
REACT_APP_CALENDLY_URL=

# Social profiles (optional — icons hidden when empty)
REACT_APP_SOCIAL_LINKEDIN=
REACT_APP_SOCIAL_GITHUB=
REACT_APP_SOCIAL_INSTAGRAM=
REACT_APP_SOCIAL_FACEBOOK=
REACT_APP_SOCIAL_TWITTER=
